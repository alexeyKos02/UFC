# Скопируйте в .env и задайте свой пароль базы.
POSTGRES_USER=ufc
# Только латинские буквы и цифры: пароль подставляется в строку подключения.
POSTGRES_PASSWORD=change_me_to_a_long_random_value
POSTGRES_DB=ufc

# Порт сайта на вашей машине.
APP_PORT=8080

# Максимальный размер загружаемого изображения в байтах.
MAX_UPLOAD_BYTES=5242880
SESSION_TTL_DAYS=30

# Поставьте true, если сайт работает по HTTPS.
COOKIE_SECURE=false
