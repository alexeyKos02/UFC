# Скопируйте в .env и задайте свой пароль базы.
POSTGRES_USER=ufc
# Только латинские буквы и цифры: пароль подставляется в строку подключения.
POSTGRES_PASSWORD=change_me_to_a_long_random_value
POSTGRES_DB=ufc

# Порт сайта на вашей машине. С HTTPS (см. ниже) — 127.0.0.1:8080, порт 80 займёт Caddy.
APP_PORT=8080

# Максимальный размер загружаемого изображения в байтах.
MAX_UPLOAD_BYTES=5242880
SESSION_TTL_DAYS=30

# Поставьте true, если сайт работает по HTTPS.
COOKIE_SECURE=false

# HTTPS для продакшена: раскомментируйте, укажите домен (A-записи @ и www на IP сервера)
# и поставьте COOKIE_SECURE=true.
# COMPOSE_PROFILES=https
# SITE_DOMAIN=example.ru
# Адреса, которые переадресуются на основной домен (по умолчанию www.<SITE_DOMAIN>):
# SITE_REDIRECTS="www.example.ru old-example.ru www.old-example.ru"
