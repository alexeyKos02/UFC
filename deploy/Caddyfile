# HTTPS перед сайтом. Сертификат Let's Encrypt Caddy получает и продлевает сам,
# http:// перенаправляет на https://. Домен задаётся в .env: SITE_DOMAIN=ufcliga.ru.

{$SITE_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy frontend:80
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# Всё остальное на порту 80 (например, старые ссылки по IP) ведёт на домен.
http:// {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
