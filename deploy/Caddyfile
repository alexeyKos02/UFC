# HTTPS перед сайтом. Сертификаты Let's Encrypt Caddy получает и продлевает сам,
# http:// перенаправляет на https://. Домены задаются в .env:
#   SITE_DOMAIN=ufclegends.ru                    основной домен
#   SITE_REDIRECTS="www.ufclegends.ru ufcliga.ru www.ufcliga.ru"
#                                                эти адреса ведут на основной
# Без SITE_REDIRECTS на основной домен ведёт только www.<SITE_DOMAIN>.
# Каждый адрес должен уже резолвиться в IP сервера, иначе сертификат не выпустится.

{$SITE_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy frontend:80
}

{$SITE_REDIRECTS} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# Всё остальное на порту 80 (например, старые ссылки по IP) ведёт на домен.
http:// {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
